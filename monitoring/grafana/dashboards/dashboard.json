{
  "dashboard": {
    "title": "ML Application Monitoring",
    "panels": [
      {"id": 1, "title": "API Request Rate", "type": "graph", "targets": [{"expr": "rate(api_requests_total[5m])"}]},
      {"id": 2, "title": "Request Latency (p95)", "type": "graph", "targets": [{"expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))"}]},
      {"id": 3, "title": "Prediction Count", "type": "stat", "targets": [{"expr": "predictions_total"}]},
      {"id": 4, "title": "Container CPU Usage", "type": "graph", "targets": [{"expr": "rate(container_cpu_usage_seconds_total[5m])"}]},
      {"id": 5, "title": "Container Memory Usage", "type": "graph", "targets": [{"expr": "container_memory_usage_bytes"}]}
    ]
  }
}
